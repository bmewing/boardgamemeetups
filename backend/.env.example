# Copy to .env for local development.

ENVIRONMENT=development

# Local Postgres (see README for creating the role and database).
# For Supabase, paste the *session pooler* connection string and append ?sslmode=require;
# the postgresql:// scheme and sslmode are adapted for asyncpg automatically.
DATABASE_URL=postgresql+asyncpg://boardgame:boardgame@localhost:5432/boardgamegroup

# Kinde: same domain and audience as the frontend's .env.local. Not secrets.
KINDE_DOMAIN=https://<your-business>.kinde.com
KINDE_AUDIENCE=https://api.boardgamemeetups

# BoardGameGeek XML API application token (secret). Create one at
# https://boardgamegeek.com/applications once your application is approved.
BGG_API_TOKEN=

# Where the web app runs, for links back to it from calendar events and emails.
APP_URL=http://localhost:5173

# Resend API key with sending access (secret). Leave blank locally to log emails instead
# of sending them.
RESEND_API_KEY=

# Discord bot: the application people sign in with (discord.com/developers/applications).
# The application ID and public key are on its General Information page and aren't
# secrets; the bot token (Bot page) is. Leave blank to keep the bot off.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
