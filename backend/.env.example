# Copy to .env for local development.

ENVIRONMENT=development

# Local Postgres (see README for creating the role and database).
# For Supabase, paste the *session pooler* connection string and append ?sslmode=require;
# the postgresql:// scheme and sslmode are adapted for asyncpg automatically.
DATABASE_URL=postgresql+asyncpg://boardgame:boardgame@localhost:5432/boardgamegroup
